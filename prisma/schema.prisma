generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

enum AppointmentType {
  ONSITE
  ONLINE
  OFFSITE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EmployeeRole {
  REFINANCE
  STAFF
  ENGINEER
  ADMIN
}

enum EmployeeAbilityTag {
  ENGINEER
  REFINANCE
  GENERAL
}

// เอาข้อมูลจากศูนย์มา
model Employee {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  fullname String?
  email    String? @unique
  password String? // optional - for future employee login
  phone    String? @unique

  role EmployeeRole @default(STAFF)

  isActive        Boolean @default(true)
  profileImageUrl String?
  bio             String?

  appointments Appointment[]
  employeeTags EmployeeTag[]
  magicLinks   MagicLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String             @id @default(auto()) @map("_id") @db.ObjectId
  name EmployeeAbilityTag @unique

  employeeTags EmployeeTag[]
}

model EmployeeTag {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId
  tag        Tag      @relation(fields: [tagId], references: [id])
  tagId      String   @db.ObjectId
}

model Customer {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  line_display_name String?
  fullname          String?
  phone             String? @unique
  line_user_id      String  @unique
  email             String?
  note              String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id     String            @id @default(auto()) @map("_id") @db.ObjectId
  type   AppointmentType
  status AppointmentStatus @default(PENDING)

  date    DateTime
  day     String
  section String

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String   @unique @db.ObjectId

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.ObjectId

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, date])
}

model MagicLink {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  token      String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}
